rules_version = '2';

// Regras do banco do Sistema Engenharia.
// Firebase → Firestore Database → Regras → cole este texto → Publicar.
//
// Quem acessa o quê fica na coleção eng_acessos (tela "Usuários e acessos" do sistema):
//   eng_acessos/<e-mail em minúsculas> = { email, nome, telas: { corridas: 'editar', retornos: 'ver', … } }
//   tela fora da lista = sem acesso.
// O administrador (admin() abaixo = ADMINS em comum/casca.js) vê e edita tudo e é o único que muda os acessos.
// Não é preciso mexer aqui para incluir ou tirar alguém: isso é feito na tela.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null && request.auth.token.email != null;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function admin() {
      return logado() && email() in ['projetos1@prometals.co'];
    }
    function caminhoAcesso() {
      return /databases/$(database)/documents/eng_acessos/$(email());
    }
    function telas() {
      return get(caminhoAcesso()).data.get('telas', {});
    }
    // vê alguma das telas da lista?
    function ve(lista) {
      return admin() || (logado() && exists(caminhoAcesso()) && telas().keys().hasAny(lista));
    }
    // edita a tela?
    function edita(tela) {
      return admin() || (logado() && exists(caminhoAcesso()) && telas().get(tela, '') == 'editar');
    }
    function soMudou(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }
    // Modelos de clientes: uma tela só para o módulo inteiro (comercial2@ e o administrador editam)
    function leMcli() {
      return ve(['modelosClientes']);
    }
    function editaMcli() {
      return edita('modelosClientes');
    }

    // ---------- Usuários e acessos ----------
    match /eng_acessos/{id} {
      allow read: if logado() && (id == email() || admin());
      allow write: if admin();
    }

    // ---------- Cálculo de Liga (os Certificados também leem) ----------
    function leLiga() {
      return ve(['corridas', 'amostras', 'retornos', 'ligas', 'materiais', 'config', 'certificados']);
    }
    match /eng_corridas/{id} {
      allow read: if leLiga();
      allow write: if edita('corridas') || edita('config');
    }
    match /eng_retornos/{id} {
      allow read: if leLiga();
      // a corrida gera/atualiza o seu retorno ao ser salva
      allow write: if edita('retornos') || edita('corridas') || edita('config');
      // o certificado automático só marca no retorno qual certificado foi criado
      allow update: if edita('certificados') && soMudou(['certificadoAuto', '_em', '_por']);
    }
    match /eng_ligas/{id} {
      allow read: if leLiga();
      allow write: if edita('ligas') || edita('config');
    }
    match /eng_materiais/{id} {
      allow read: if leLiga();
      allow write: if edita('materiais') || edita('config');
    }
    match /eng_config/{id} {
      // "modelosClientes" = dados da empresa e texto da declaração do documento de devolução
      allow read: if id == 'modelosClientes' ? leMcli() : leLiga();
      // "certificado" = assinatura dos certificados; "liga" = forno, numeração, dados do formulário do laboratório
      allow write: if id == 'modelosClientes' ? editaMcli()
        : id == 'certificado' ? edita('certificados')
        : (edita('corridas') || edita('amostras') || edita('config'));
    }

    // ---------- Certificados ----------
    match /eng_certificados/{id} {
      allow read: if ve(['certificados', 'corridas', 'retornos']);
      allow write: if edita('certificados');
    }

    // ---------- Controle de Modelos ----------
    function leModelos() {
      return ve(['mapa', 'modelos', 'comercial', 'ruas']);
    }
    match /eng_modelos/{id} {
      allow read: if leModelos();
      allow write: if edita('modelos') || edita('ruas');
      // manutenção: só pode mudar a situação e o histórico de um modelo que já existe
      allow update: if edita('manutencao') && soMudou(['situacao', 'historico', '_em', '_por']);
    }
    match /eng_ruas/{id} {
      allow read: if leModelos();
      allow write: if edita('ruas') || edita('modelos');
    }
    match /eng_arquivos/{id} {          // PDFs dos desenhos (modelo_…) e fotos dos modelos de clientes (mcli_…)
      allow read: if id.matches('mcli_.*') ? leMcli() : leModelos();
      allow write: if id.matches('mcli_.*') ? editaMcli() : edita('modelos');
    }

    // ---------- Modelos de clientes (tela "modelosClientes") ----------
    match /eng_clientes/{id} {
      allow read: if leMcli();
      allow write: if editaMcli();
    }
    match /eng_mcli_modelos/{id} {
      allow read: if leMcli();
      allow write: if editaMcli();
    }
    match /eng_mcli_eventos/{id} {
      allow read: if leMcli();
      allow write: if editaMcli();
    }
    match /eng_mcli_devolucoes/{id} {
      allow read: if leMcli();
      allow write: if editaMcli();
    }
  }
}
