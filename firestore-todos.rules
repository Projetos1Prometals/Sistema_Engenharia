rules_version = '2';

// Regras PROVISÓRIAS (enquanto RESTRINGIR = false em comum/casca.js):
// toda pessoa cadastrada na tela "Usuários e acessos" (documento em eng_acessos) vê e edita tudo.
// Só o administrador mexe em Usuários e acessos.
// Para restringir por tela: RESTRINGIR = true em comum/casca.js e publicar o firestore.rules no lugar deste.
// Firebase → Firestore Database → Regras → cole este texto → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null && request.auth.token.email != null;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function admin() {
      return logado() && email() in ['projetos1@prometals.co'];
    }
    function cadastrado() {
      return admin() || (logado() && exists(/databases/$(database)/documents/eng_acessos/$(email())));
    }

    match /eng_acessos/{id} {
      allow read: if logado() && (id == email() || admin());
      allow write: if admin();
    }

    // Demais dados do sistema: coleções que começam com "eng_"
    match /{colecao}/{doc} {
      allow read, write: if colecao.matches('eng_.*') && colecao != 'eng_acessos' && cadastrado();
    }
  }
}
